# 统一换行符: 仓库内存 LF, 检出时按平台转换
* text=auto

# 脚本必须锁定 LF/CRLF, 否则跨平台会报 "bad interpreter" / "\r: command not found"
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制资源不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.exe   binary
*.dll   binary
*.pyd   binary
resources/stealth.min.js -text
